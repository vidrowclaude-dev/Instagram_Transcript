<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="co.vidrow.editkit" ExtensionBundleVersion="1.0.0" ExtensionBundleName="Vidrow Edit Kit"
