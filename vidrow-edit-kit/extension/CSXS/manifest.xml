          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Vidrow Edit Kit</Menu>
          <Geometry>
            <Size><Height>860</Height><Width>440</Width></Size>
            <MinSize><Height>480</Height><Width>340</Width></MinSize>
            <MaxSize><Height>2400</Height><Width>1200</Width></MaxSize>
