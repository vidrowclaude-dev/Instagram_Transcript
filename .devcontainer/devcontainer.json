{
  "name": "Reel Vault",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  // 4 cores makes local Whisper usable; 2-core machines work but transcribe slowly.
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },

  // Installs ffmpeg + Python packages and writes .env (first creation only).
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Starts the app every time the codespace starts or resumes.
  "postStartCommand": "bash .devcontainer/start.sh",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Reel Vault",
      "onAutoForward": "openBrowser"
    }
  },

  // No Redis in a codespace: jobs run inside the app process.
  "containerEnv": {
    "QUEUE_BACKEND": "thread"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
