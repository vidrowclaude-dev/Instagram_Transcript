# Copy to .env and adjust. Every value here has a sensible default.

# ---- Storage ----
# DATA_DIR=./data                    # videos, transcripts, database, exports (Docker sets /data)
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/reelvault   # default: SQLite in DATA_DIR

# ---- Queue ----
# QUEUE_BACKEND=auto                 # auto | rq | thread  (auto uses Redis if it answers, else in-process)
# REDIS_URL=redis://localhost:6379/0

# ---- Transcription ----
TRANSCRIBE_ENGINE=faster_whisper     # faster_whisper | openai | deepgram | assemblyai
WHISPER_MODEL=large-v3               # large-v3 (best) | medium | small (fast on CPU) | base | tiny
WHISPER_DEVICE=auto                  # auto | cpu | cuda
WHISPER_COMPUTE_TYPE=auto            # auto picks int8 on CPU, float16 on GPU
HOOK_SECONDS=3

OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
ASSEMBLYAI_API_KEY=

# ---- Instagram rate limiting (keep these conservative) ----
MIN_DELAY=4                          # seconds, random pause between requests: lower bound
MAX_DELAY=9                          # upper bound
CONCURRENCY=2                        # parallel downloads per job
BACKOFF_BASE=60                      # first cooldown after a 429; doubles each time
BACKOFF_MAX=900                      # longest single cooldown (15 min)
MAX_COOLDOWNS=6                      # stop the job after this many cooldowns in a row
MAX_SCAN=600                         # max posts read per profile when sorting by views

# ---- Try it without Instagram ----
# DEMO_MODE=true                     # @demo_brand, @demo_private, @demo_missing use fake data
